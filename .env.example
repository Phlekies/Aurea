# Published ports for Docker Compose. Local Vite uses 5173 and FastAPI 8000.
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Local Vite proxy destination. Compose sets this to its backend service.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional direct API origin; leave blank to use the same-origin Vite proxy.
VITE_API_BASE_URL=
# Audio retention and limits. Local backend reads environment variables;
# Compose reads these from .env automatically.
AUREA_MAX_UPLOAD_BYTES=104857600
AUREA_MAX_DURATION_SECONDS=1800
AUREA_RETENTION_SECONDS=86400
# Optional local decoder locations when binaries are not in PATH.
# AUREA_FFMPEG=ffmpeg
# AUREA_FFPROBE=ffprobe
# AUREA_STORAGE_DIR=data/audio
