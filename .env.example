# Published ports for Docker Compose. Local Vite uses 5173 and FastAPI 8000.
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Local Vite proxy destination. Compose sets this to its backend service.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional direct API origin; leave blank to use the same-origin Vite proxy.
VITE_API_BASE_URL=

